<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource SurfaceContainer}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLow}" />
        <Setter Property="BorderColor" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.42" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLow}" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLow}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="TitleColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLow}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource PrimaryContainer}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{DynamicResource Error}" />
    </Style>

    <Style x:Key="GroupLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="4,14,4,6" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="ScreenTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLow}" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SegContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainer}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="SegButton" TargetType="Button">
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="Key" TargetType="Button">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="MinimumHeightRequest" Value="56" />

        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style x:Key="FlatRow" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="60" />
        <Setter Property="Padding" Value="12,12" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="56" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryContainer}" />
        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="TextColor" Value="{DynamicResource OnSecondaryContainer}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ErrorContainer}" />
        <Setter Property="TextColor" Value="{DynamicResource OnErrorContainer}" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="FieldError" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Error}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="SemanticProperties.Hint" Value="Ошибка ввода" />
    </Style>
</ResourceDictionary>
