<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Дизайн-система «Clean» (минимализм): нейтральная база + оранжевый акцент.
         Пары значений светлая/тёмная; подстановка через
         {AppThemeBinding Light={StaticResource X_Light}, Dark={StaticResource X_Dark}}. -->

    <Color x:Key="PageBgLight">#FAF9F7</Color>
    <Color x:Key="PageBgDark">#17191D</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#22262B</Color>
    <Color x:Key="SoftBgLight">#F0F2F1</Color>
    <Color x:Key="SoftBgDark">#292E33</Color>
    <Color x:Key="KeyBgLight">#EFF2F0</Color>
    <Color x:Key="KeyBgDark">#30363B</Color>
    <Color x:Key="BorderLight">#E1E5E2</Color>
    <Color x:Key="BorderDark">#3A4146</Color>
    <Color x:Key="TextPrimaryLight">#253038</Color>
    <Color x:Key="TextPrimaryDark">#F1F3F2</Color>
    <Color x:Key="TextSecondaryLight">#58646A</Color>
    <Color x:Key="TextSecondaryDark">#B9C3C5</Color>
    <Color x:Key="TextMutedLight">#667278</Color>
    <Color x:Key="TextMutedDark">#A7B3B6</Color>
    <Color x:Key="Accent">#C97753</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="AccentText">#96502F</Color>
    <Color x:Key="AccentSoft">#F8EAE2</Color>
    <Color x:Key="ExpenseLight">#B96F78</Color>
    <Color x:Key="ExpenseDark">#DDA2A9</Color>
    <Color x:Key="ExpenseTextLight">#934C58</Color>
    <Color x:Key="ExpenseTextDark">#EFC0C4</Color>
    <Color x:Key="ExpenseSoftLight">#F7E9EB</Color>
    <Color x:Key="ExpenseSoftDark">#423137</Color>
    <Color x:Key="IncomeLight">#5C9474</Color>
    <Color x:Key="IncomeDark">#9CC5A9</Color>
    <Color x:Key="IncomeTextLight">#3B7354</Color>
    <Color x:Key="IncomeTextDark">#B7DDC2</Color>
    <Color x:Key="IncomeSoftLight">#E7F2E9</Color>
    <Color x:Key="IncomeSoftDark">#2C4136</Color>
    <Color x:Key="TransferLight">#50505A</Color>
    <Color x:Key="TransferDark">#B9B9C2</Color>
    <Color x:Key="WarnLight">#B89559</Color>
    <Color x:Key="WarnDark">#D8BD82</Color>
