<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.AccountsPage"
             Title="Счета"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12,6">

        <Label Grid.Row="0" Text="{Binding TotalText}" FontFamily="InterSemiBold" Padding="4,6,0,8"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Удалить" BackgroundColor="{AppThemeBinding Light={StaticResource ExpenseLight}, Dark={StaticResource ExpenseDark}}" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="6,12" ColumnDefinitions="Auto,44,*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" WidthRequest="12" HeightRequest="12" StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{Binding ColorHex}" StrokeThickness="0" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding Icon}" FontSize="20"/>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="{Binding Name}" FontFamily="InterSemiBold"/>
                                <Label Text="{Binding Subtitle}" FontSize="12" Opacity="0.5"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="3" Text="{Binding BalanceText}" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:AccountsViewModel}}}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
