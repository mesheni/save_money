<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.AccountsPage"
             Title="Счета"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить счёт" Command="{Binding AddCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{DynamicResource OnSurface}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,12">

        <Label Grid.Row="0" Text="{Binding TotalText}" FontFamily="InterSemiBold" Padding="4,6,0,8"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Удалить" BackgroundColor="{DynamicResource Error}" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid RowDefinitions="Auto,1">
                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid  MinimumHeightRequest="60" Padding="16,12" ColumnDefinitions="24,*,Auto" ColumnSpacing="10"
                                  BackgroundColor="Transparent"
                                  SemanticProperties.Hint="Открыть счёт для изменения">
                                <Label Grid.Column="0" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24"
                                       TextColor="{DynamicResource OnSurface}"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Border WidthRequest="8" HeightRequest="8" StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{Binding ColorHex}" StrokeThickness="0" VerticalOptions="Center"/>
                                        <Label Text="{Binding Name}" FontSize="16" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Subtitle}" FontSize="14"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Label Text="{Binding BalanceText}" FontSize="16" FontFamily="InterSemiBold" VerticalOptions="Center" HorizontalOptions="End"/>
</VerticalStackLayout>

                                <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" VerticalOptions="Center"
                                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:AccountsViewModel}}}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
</Border>

                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Text="Счетов пока нет — добавьте первый кнопкой сверху"
               IsVisible="{Binding HasNoRows}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{DynamicResource OnSurfaceVariant}"/>

    </Grid>

</ContentPage>
