<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.DebtEditPage"
             Title="{Binding Title}"
             Appearing="OnAppearing">

    <ScrollView>
        <VerticalStackLayout Padding="16,10" Spacing="12">

            <Label Text="Направление" FontSize="12" Opacity="0.6" IsVisible="{Binding IsPersonalDebt}"/>
            <Border Padding="12,0" MinimumHeightRequest="48" IsVisible="{Binding IsPersonalDebt}"><Picker ItemsSource="{Binding DirectionOptions}" SelectedIndex="{Binding DirectionIndex}" BackgroundColor="Transparent"/></Border>

            <Label Text="Тип задолженности" FontSize="12" Opacity="0.6"/>
            <Border Padding="12,0" MinimumHeightRequest="48"><Picker ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" BackgroundColor="Transparent"/></Border>

            <Label Text="Кто" FontSize="12" Opacity="0.6"/>
            <Border Padding="12,0" MinimumHeightRequest="48"><Entry Text="{Binding PersonName}" Placeholder="Имя человека или организации" BackgroundColor="Transparent"/></Border>

            <Label Text="Полная сумма, ₽" FontSize="12" Opacity="0.6"/>
            <Border Padding="12,0" MinimumHeightRequest="48"><Entry Text="{Binding AmountText}" Placeholder="0" Keyboard="Numeric" BackgroundColor="Transparent"/></Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Есть срок возврата" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="{Binding HasDueDate}"/>
            </Grid>

            <Border Padding="12,0" MinimumHeightRequest="48" IsVisible="{Binding HasDueDate}"><DatePicker Date="{Binding DueDate}" Format="d MMMM yyyy"/></Border>

            <Label Text="Счёт по умолчанию для возврата" FontSize="12" Opacity="0.6"/>
            <Border Padding="12,0" MinimumHeightRequest="48"><Picker ItemsSource="{Binding AccountOptions}" SelectedIndex="{Binding AccountIndex}" BackgroundColor="Transparent"/></Border>

            <Label Text="Заметка" FontSize="12" Opacity="0.6"/>
            <Border Padding="12,0" MinimumHeightRequest="48"><Entry Text="{Binding Note}" Placeholder="Необязательно" BackgroundColor="Transparent"/></Border>

            <Button Text="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
