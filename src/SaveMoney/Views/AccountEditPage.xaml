<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.AccountEditPage"
             Title="{Binding Title}"
             Appearing="OnAppearing">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16,10" Spacing="12">

            <Label Text="Название" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <Border StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48">
                <Entry Text="{Binding Name}" Placeholder="Например, Сбер карта"
                       BackgroundColor="Transparent" MinimumHeightRequest="48"/>
            </Border>
            <ctl:ValidationMessage Text="{Binding NameError}"/>

            <Label Text="Тип" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <Border StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48">
                <ctl:MonetPicker ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}"
                        BackgroundColor="Transparent" VerticalOptions="Center"/>
            </Border>

            <Label Text="Начальный остаток, ₽ (можно с минусом для кредитки)" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <Border StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48">
                <Entry Text="{Binding InitialBalanceText}" Placeholder="0" Keyboard="Numeric"
                       BackgroundColor="Transparent" MinimumHeightRequest="48"/>
            </Border>

            <Label Text="Цвет" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <ctl:AppearancePicker IsColorPicker="True" ItemsSource="{Binding Colors}" SelectionCommand="{Binding SelectColorCommand}"/>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Учитывать в общем балансе" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="{Binding IncludeInTotal}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Архивный (скрыт из ввода)" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="{Binding Archived}"/>
            </Grid>

            <Button Text="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>

            <Button Text="Удалить счёт" TextColor="{DynamicResource Error}" BackgroundColor="Transparent"
                    IsVisible="{Binding IsExisting}" Command="{Binding DeleteCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
