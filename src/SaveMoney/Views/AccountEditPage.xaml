<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.AccountEditPage"
             Title="{Binding Title}"
             Appearing="OnAppearing">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16,10" Spacing="12">

            <Label Text="Название" FontSize="12" Opacity="0.6"/>
            <Border StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                <Entry Text="{Binding Name}" Placeholder="Например, Сбер карта"
                       BackgroundColor="Transparent" MinimumHeightRequest="42"/>
            </Border>

            <Label Text="Тип" FontSize="12" Opacity="0.6"/>
            <Border StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                <Picker ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}"
                        BackgroundColor="Transparent" VerticalOptions="Center"/>
            </Border>

            <Label Text="Начальный остаток, ₽ (можно с минусом для кредитки)" FontSize="12" Opacity="0.6"/>
            <Border StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                <Entry Text="{Binding InitialBalanceText}" Placeholder="0" Keyboard="Numeric"
                       BackgroundColor="Transparent" MinimumHeightRequest="42"/>
            </Border>

            <Label Text="Цвет" FontSize="12" Opacity="0.6"/>
            <CollectionView ItemsSource="{Binding Colors}" HeightRequest="216" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorChip">
                        <Border MinimumHeightRequest="48" MinimumWidthRequest="48"
                                SemanticProperties.Description="{Binding AccessibleName}" SemanticProperties.Hint="Выбрать цвет счёта"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{Binding Hex}"
                                StrokeThickness="3"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                        Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type vm:AccountEditViewModel}}}"
                                        CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibleName}"
                                        SemanticProperties.Hint="Выбрать цвет счёта"/>
                                <Label Text="✓" IsVisible="{Binding IsSelected}" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="White" InputTransparent="True" FontFamily="InterBold" FontSize="20"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Учитывать в общем балансе" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="{Binding IncludeInTotal}"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Архивный (скрыт из ввода)" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="{Binding Archived}"/>
            </Grid>

            <Button Text="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>

            <Button Text="Удалить счёт" TextColor="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}" BackgroundColor="Transparent"
                    IsVisible="{Binding IsExisting}" Command="{Binding DeleteCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
