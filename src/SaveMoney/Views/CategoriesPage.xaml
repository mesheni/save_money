<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.CategoriesPage"
             Title="Категории"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋" Command="{Binding AddRootCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12,6">

        <Picker Grid.Row="0" ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" WidthRequest="160"
                HorizontalOptions="Start"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRowVM">
                    <Grid Padding="6,10" ColumnDefinitions="*,Auto,Auto" Margin="{Binding RowMargin}">
                        <Label Grid.Column="0" FontSize="15">
                            <Label.Text>
                                <MultiBinding StringFormat="{0} {1}">
                                    <Binding Path="Icon"/>
                                    <Binding Path="Name"/>
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Button Grid.Column="1" Text="＋" FontSize="14" Padding="8,0" BackgroundColor="Transparent" TextColor="#512BD4"
                                IsVisible="{Binding ShowAddChild}"
                                Command="{Binding AddChildCommand, Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}}"
                                CommandParameter="{Binding .}"/>
                        <Button Grid.Column="2" Text="🗑" FontSize="14" Padding="8,0" BackgroundColor="Transparent" TextColor="#E74C3C"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
