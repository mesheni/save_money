<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.CategoriesPage"
             Title="Категории"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddRootCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12,6">

        <Picker Grid.Row="0" ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" WidthRequest="160"
                HorizontalOptions="Start"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRowVM">
                    <Border Style="{StaticResource ListRow}" Margin="{Binding RowMargin}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" FontSize="15">
                                <Label.Text>
                                    <MultiBinding StringFormat="{0} {1}">
                                        <Binding Path="Icon"/>
                                        <Binding Path="Name"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Button Grid.Column="1" Text="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" FontSize="17" Padding="10,6" Style="{StaticResource GhostButton}"
                                IsVisible="{Binding ShowAddChild}"
                                Command="{Binding AddChildCommand, Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}}"
                                CommandParameter="{Binding .}"/>
                            <Button Grid.Column="2" Text="{x:Static ctl:Glyphs.Delete}" FontFamily="MaterialSymbolsRounded" FontSize="17" Padding="10,6" Style="{StaticResource DangerButton}"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}}"
                                CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Text="Категорий нет — добавьте первую кнопкой сверху"
               IsVisible="{Binding HasNoRows}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>

    </Grid>

</ContentPage>
