<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.CategoriesPage"
             Title="Категории"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить категорию" Command="{Binding AddRootCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{DynamicResource OnSurface}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,12">

        <ctl:MonetPicker Grid.Row="0" ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" WidthRequest="160"
                HorizontalOptions="Start"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRowVM">
                    <Grid RowDefinitions="Auto,1" Margin="{Binding RowMargin}">
                        <Grid Grid.Row="0" MinimumHeightRequest="56" Padding="0,4" ColumnDefinitions="*,Auto,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="10">
                                <Label Text="{Binding Icon, Converter={StaticResource IconGlyph}}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="20"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource OnSurface}"/>
                                <Label FontSize="16" Text="{Binding Name}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1" Text="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="17" Padding="10,6" Style="{StaticResource GhostButton}"
                                IsVisible="{Binding ShowAddChild}"
                                Command="{Binding AddChildCommand, Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}}"
                                CommandParameter="{Binding .}"/>
                            <Button Grid.Column="2" Text="{x:Static ctl:Glyphs.Delete}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="17" Padding="10,6" Style="{StaticResource DangerButton}"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding DeleteCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}}"
                                CommandParameter="{Binding .}"/>
                        </Grid>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Text="Категорий нет — добавьте первую кнопкой сверху"
               IsVisible="{Binding HasNoRows}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{DynamicResource OnSurfaceVariant}"/>

    </Grid>

</ContentPage>
