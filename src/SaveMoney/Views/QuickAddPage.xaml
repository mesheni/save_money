<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.QuickAddPage"
             Title="{Binding ModeText}"
             Appearing="OnAppearing">

    <!-- Один экран без прокрутки: баланс-строка, сегмент, сумма, чипы выбора,
         клавиатура с правой колонкой (дата / «ещё» / сохранить). -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="14,8,14,12">

        <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalOptions="Center">
            <Label Text="Баланс по счетам" FontSize="12" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
            <Label x:Name="BalanceLabel" Text="{Binding BalanceText}" FontSize="13" FontFamily="InterSemiBold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   VerticalOptions="Center"/>
        </StackLayout>

        <Border Grid.Row="1" Style="{StaticResource SegContainer}">
            <Grid x:Name="SegGrid" ColumnDefinitions="*,*,*" ColumnSpacing="3">
                <Button Grid.Column="0" Text="Расход" Style="{StaticResource SegButton}"
                        Command="{Binding SetExpenseCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsExpenseMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Доход" Style="{StaticResource SegButton}"
                        Command="{Binding SetIncomeCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsIncome}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Перевод" Style="{StaticResource SegButton}"
                        Command="{Binding SetTransferCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTransfer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="6">
            <Label Text="{Binding AmountDisplay}" FontSize="38" FontFamily="InterSemiBold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
            <Label Text="₽" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   VerticalOptions="End" Margin="0,0,0,5"/>
        </HorizontalStackLayout>

        <!-- Выбор: категория (или «куда» для перевода), затем счёт. Горизонтальные ленты. -->
        <VerticalStackLayout Grid.Row="3" Spacing="6">

            <VerticalStackLayout Spacing="2" IsVisible="{Binding IsOperation}">
                <Label Text="Категория" FontSize="11" Margin="2,0"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                <CollectionView ItemsSource="{Binding RootCategories}" ItemsLayout="HorizontalList" HeightRequest="44">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChip">
                            <Border StrokeShape="RoundRectangle 20" Padding="13,9" Margin="0,0,8,0" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Display}" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectRootCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView ItemsSource="{Binding SubCategories}" ItemsLayout="HorizontalList" HeightRequest="44"
                                Margin="0,6,0,0"
                                IsVisible="{Binding HasSubCategories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryChip">
                            <Border StrokeShape="RoundRectangle 20" Padding="13,9" Margin="0,0,8,0" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Display}" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSubCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2" IsVisible="{Binding IsTransfer}">
                <Label Text="Куда" FontSize="11" Margin="2,0"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                <CollectionView ItemsSource="{Binding TargetAccounts}" ItemsLayout="HorizontalList" HeightRequest="44">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountChip">
                            <Border StrokeShape="RoundRectangle 20" Padding="13,9" Margin="0,0,8,0" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Name}" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectTargetCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Счёт" FontSize="11" Margin="2,0"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                <CollectionView ItemsSource="{Binding Accounts}" ItemsLayout="HorizontalList" HeightRequest="44">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountChip">
                            <Border StrokeShape="RoundRectangle 20" Padding="13,9" Margin="0,0,8,0" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Name}" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectAccountCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- Низ: свёрнутая панель «ещё» + клавиатура с правой колонкой действий. -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="8">

            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="6">
                <Entry Text="{Binding Payee}" Placeholder="Магазин — по нему угадается категория"
                       IsVisible="{Binding IsExpenseMode}" ClearButtonVisibility="WhileEditing"/>
                <Entry Text="{Binding Note}" Placeholder="Заметка" ClearButtonVisibility="WhileEditing"/>
            </VerticalStackLayout>

            <Grid x:Name="Keypad" Grid.Row="1" ColumnDefinitions="*,*,*,1.2*" RowDefinitions="*,*,*,*"
                  ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="1"/>
                <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="2"/>
                <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="3"/>
                <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="4"/>
                <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="5"/>
                <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="6"/>
                <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="7"/>
                <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="8"/>
                <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="9"/>
                <Button Grid.Row="3" Grid.Column="0" Text="," Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter=","/>
                <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="0"/>
                <Button Grid.Row="3" Grid.Column="2" Text="⌫" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="⌫"/>

                <!-- Дата: по умолчанию «сегодня», меняется в два тапа. -->
                <Border Grid.Row="0" Grid.Column="3" StrokeShape="RoundRectangle 14" StrokeThickness="1" Padding="4,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <DatePicker Date="{Binding Date}" Format="d MMM" FontSize="13"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- «Ещё»: магазин/заметка раскрываются на месте. -->
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource Key}"
                        Command="{Binding ToggleMoreCommand}"
                        FontFamily="MaterialSymbolsRounded" FontSize="20" Text="{x:Static ctl:Glyphs.MoreHoriz}"/>

                <Button x:Name="SaveButton" Grid.Row="2" Grid.RowSpan="2" Grid.Column="3"
                        Text="Сохранить" FontSize="13" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
            </Grid>

        </Grid>

        <!-- Тост «Сохранено»: вписан в дизайн-систему вместо системного снекбара -->
        <Border x:Name="SavedToast" IsVisible="False" Opacity="0"
                StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="18,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                HorizontalOptions="Center" VerticalOptions="End" Margin="16,0,16,16"
                InputTransparent="True">
            <Label Text="Сохранено ✓" TextColor="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"
                   FontFamily="InterSemiBold" FontSize="14" />
        </Border>

    </Grid>

</ContentPage>
