<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:core="clr-namespace:SaveMoney.Core.Services;assembly=SaveMoney.Core"
             x:Class="SaveMoney.Views.QuickAddPage"
             Title="{Binding ModeText}"
             Shell.NavBarIsVisible="False"
             Appearing="OnAppearing">

    <!-- Экран ввода по макету: шапка (всего/долги + пилюля «в день до зарплаты»), сегмент,
         крупная сумма с кареткой, строка полей (магазин/счёт), при переводе — пилюля
         погашения долга, сетка категорий 4×2, подкатегории лентой, клавиатура 4×3.
         Навбар Shell скрыт (режим виден в сегменте) — иначе контент не влезает
         на устройство; клавиатура Auto с фикс. клавишами, наезды исключены. -->
    <Grid RowDefinitions="*,Auto" RowSpacing="6" Padding="14,6,14,8">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="6">

        <!-- Шапка: режим (при правке), баланс и сальдо долгов слева, пилюля «в день до зарплаты» справа. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="{Binding ModeText}" FontSize="12" FontFamily="InterSemiBold"
                       IsVisible="{Binding IsEditing}"
                       TextColor="{DynamicResource AccentText}"/>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="5" RowSpacing="1">
                    <Label Text="Всего" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Grid.Column="1" x:Name="BalanceLabel" Text="{Binding BalanceText}" FontSize="14" FontFamily="InterSemiBold"/>
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DebtsSummaryText}" FontSize="14" FontFamily="InterSemiBold"
                           IsVisible="{Binding HasDebtsSummary}" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </Grid>
            </VerticalStackLayout>
            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12,0,10,0" HeightRequest="32"
                    BackgroundColor="{DynamicResource AccentSoft}"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasPaydayHint}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPaydayCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding PaydayHintText}" FontSize="13" FontFamily="InterSemiBold"
                           TextColor="{DynamicResource AccentText}"/>
                    <Label Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{DynamicResource AccentText}"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Сегмент: активная кнопка — карточка с рамкой, неактивные — прозрачные. -->
        <Border Grid.Row="1" Style="{StaticResource SegContainer}">
            <Grid x:Name="SegGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="3" RowSpacing="3">
                <Button Grid.Column="0" Text="Расход" Style="{StaticResource SegButton}" Padding="4,0"
                        Command="{Binding SetExpenseCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsExpenseMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Доход" Style="{StaticResource SegButton}" Padding="4,0"
                        Command="{Binding SetIncomeCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsIncome}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Text="Перевод" Style="{StaticResource SegButton}" Padding="4,0"
                        Command="{Binding SetTransferCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTransfer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Text="Погашение" Style="{StaticResource SegButton}" Padding="4,0"
                        Command="{Binding SetRepaymentCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsRepayment}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <VerticalStackLayout IsVisible="{Binding IsRepayment}" Spacing="8">
            <Button Text="{Binding DebtButtonText}" Command="{Binding PickDebtCommand}"
                    Style="{StaticResource GhostButton}" LineBreakMode="WordWrap"
                    HorizontalOptions="Fill" SemanticProperties.Description="Выбрать задолженность"/>
            <Label Text="{Binding RepaymentRemainingText}" IsVisible="{Binding HasRepaymentTarget}" FontSize="14" HorizontalTextAlignment="Center"/>
            <VerticalStackLayout IsVisible="{Binding IsChoosingRepayment}" Spacing="8">
                <Label Text="Нет открытых задолженностей. Добавьте долг, кредит или кредитный счёт с отрицательным балансом."
                       IsVisible="{Binding HasNoRepaymentTargets}" FontSize="14"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RepaymentTargets}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="core:RepaymentTarget">
                            <Button Text="{Binding Label}" LineBreakMode="WordWrap" MinimumHeightRequest="56"
                                    Padding="12,8" Style="{StaticResource GhostButton}"
                                    Command="{Binding SelectRepaymentCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}"
                                    CommandParameter="{Binding .}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Добавить долг" Command="{Binding AddPersonalDebtCommand}" Style="{StaticResource GhostButton}"/>
                <Button Text="Добавить кредит" Command="{Binding AddConsumerLoanCommand}" Style="{StaticResource GhostButton}"/>
                <Button Text="Добавить кредитный счёт" Command="{Binding AddCreditAccountCommand}" Style="{StaticResource GhostButton}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Одна строка сохраняет общую базовую линию знака, числа и валюты. -->
        <Label Grid.Row="2" FontSize="{Binding AmountFontSize}" FontFamily="InterSemiBold"
               MinimumHeightRequest="56" VerticalTextAlignment="Center" HorizontalTextAlignment="End"
               LineBreakMode="NoWrap" Margin="0,2">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{Binding SignText}"/>
                    <Span Text="&#160;"/>
                    <Span Text="{Binding AmountDisplay}"/>
                    <Span Text="&#160;₽" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Строка полей: магазин/заметка, счёт (и «куда» при переводе). -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="6">
            <Border Grid.Row="0" Grid.ColumnSpan="2" StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Text="{x:Static ctl:Glyphs.Search}" FontFamily="MaterialSymbolsRounded" FontSize="18"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Entry Grid.Column="1" Text="{Binding MemoText}" Placeholder="{Binding MemoPlaceholder}"
                           BackgroundColor="Transparent" FontSize="15" MinimumHeightRequest="42"
                           ClearButtonVisibility="WhileEditing"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48"
                    SemanticProperties.Description="Выбрать счёт" SemanticProperties.Hint="Открывает список счетов">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsRepayment}" Value="True">
                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                    </DataTrigger>
                </Border.Triggers>
                <Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" VerticalOptions="Center">
                    <Label Text="{x:Static ctl:Glyphs.CreditCard}" FontFamily="MaterialSymbolsRounded" FontSize="18"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Grid.Column="1" Text="{Binding AccountPickerText}" FontSize="14" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                    <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </Grid>
                <Button Text="" Command="{Binding PickAccountCommand}" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        SemanticProperties.Description="Выбрать счёт" SemanticProperties.Hint="Открывает список счетов"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48"
                    SemanticProperties.Description="Выбрать счёт назначения" SemanticProperties.Hint="Открывает список счетов"
                    IsVisible="{Binding IsTransfer}">
                <Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" VerticalOptions="Center">
                    <Label Text="{x:Static ctl:Glyphs.SwapHoriz}" FontFamily="MaterialSymbolsRounded" FontSize="18"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Grid.Column="1" Text="{Binding TargetPickerText}" FontSize="14" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                    <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </Grid>
                <Button Text="" Command="{Binding PickTargetCommand}" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        SemanticProperties.Description="Выбрать счёт назначения" SemanticProperties.Hint="Открывает список счетов"/>
                </Grid>
            </Border>
        </Grid>

        <Button Text="Погасить долг" Command="{Binding SaveCommand}" IsVisible="{Binding IsRepayment}"
                Style="{StaticResource PrimaryButton}" HeightRequest="-1" MinimumHeightRequest="48"
                Padding="12,8" LineBreakMode="WordWrap"/>

        <!-- Категории: сетка 4×2, лента подкатегорий под ней. Блок лежит в компактном
             ScrollView без полосы: на низких экранах скроллится он, клавиатура
             и её цифры не сжимаются никогда. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsOperation}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding CategoryLabelText}" FontSize="13" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Button Grid.Column="1" Text="Все" Style="{StaticResource GhostButton}" FontSize="13"
                            Command="{Binding OpenAllCategoriesCommand}"/>
                </Grid>

            <CollectionView ItemsSource="{Binding TopCategories}" HeightRequest="152"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4"
                                     HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChip">
                        <Border MinimumHeightRequest="64" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="4"
                                SemanticProperties.Description="{Binding AccessibleName}" SemanticProperties.Hint="Выбрать категорию"
                                BackgroundColor="{AppThemeBinding Light={StaticResource KeyBgLight}, Dark={StaticResource KeyBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                                <Label Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                       FontFamily="MaterialSymbolsRounded" FontSize="22"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Name}" FontSize="11" LineBreakMode="TailTruncation"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="FontFamily" Value="InterSemiBold"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                    Command="{Binding SelectRootCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibleName}"
                                    SemanticProperties.Hint="Выбрать категорию"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Подкатегории выбранного корня: горизонтальная лента чипов. -->
            <FlexLayout BindableLayout.ItemsSource="{Binding SubCategories}" Direction="Row" Wrap="Wrap"
                        JustifyContent="Center" AlignItems="Center" IsVisible="{Binding HasSubCategories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChip">
                        <Grid ColumnDefinitions="Auto" MinimumHeightRequest="48" MaximumWidthRequest="260" Margin="4,0,4,4">
                            <Border Grid.Column="0" MinimumHeightRequest="40" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 18" Padding="10,4" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}"/>
                                        <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding Name}" FontSize="14" VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Button Grid.Column="0" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                    HorizontalOptions="Fill" VerticalOptions="Fill" MinimumWidthRequest="0" MinimumHeightRequest="48"
                                    Command="{Binding SelectSubCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibleName}"
                                    SemanticProperties.Hint="Выбрать подкатегорию"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>

        <!-- Клавиатура 4×3: цифры, стирание, дата, «Сохранить» высотой в два ряда.
             Ряды Auto с фикс. высотой клавиш: экран любой высоты не обрезает цифры. -->
        <Grid x:Name="Keypad" Grid.Row="1" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="6" RowSpacing="6">
            <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="1"/>
            <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="2"/>
            <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="3"/>
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="backspace" SemanticProperties.Description="Удалить последнюю цифру"
                    FontFamily="MaterialSymbolsRounded" FontSize="22" Text="{x:Static ctl:Glyphs.Delete}"/>

            <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="4"/>
            <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="5"/>
            <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="6"/>
            <!-- Дата: невидимый DatePicker ловит тап и открывает календарь,
                 подпись («Сегодня» / «25 окт») пишет Label — Format-literal
                 на Android DatePicker не отрисовывается. -->
            <Border Grid.Row="1" Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource KeyBgLight}, Dark={StaticResource KeyBgDark}}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="2" Padding="0,4">
                    <DatePicker x:Name="DatePickerControl" Grid.Row="0" Grid.RowSpan="2" Date="{Binding Date}"
                                IsVisible="{OnPlatform Android=False, Default=True}"
                                Opacity="0" BackgroundColor="Transparent" MinimumHeightRequest="0"
                                HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                SemanticProperties.Description="Дата операции"/>
                    <Label Grid.Row="0" Text="{x:Static ctl:Glyphs.Calendar}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                           InputTransparent="True"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Label Grid.Row="1" Text="{Binding DateButtonText}" FontSize="11" InputTransparent="True"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Button Grid.RowSpan="2" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                            Clicked="OnPickDateClicked" SemanticProperties.Description="Выбрать дату операции"
                            SemanticProperties.Hint="Открывает календарь"/>
                </Grid>
            </Border>

            <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="7"/>
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="8"/>
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="9"/>

            <!-- «Сохранить»: без PrimaryButton-стиля — он фиксирует высоту 50,
                 из-за чего кнопка болталась в центре двух рядов с пустотами.
                 Fill растягивает ровно на высоту ячейки (2 ряда). -->
            <Button x:Name="SaveButton" Grid.Row="2" Grid.RowSpan="2" Grid.Column="3"
                    Text="{Binding SaveButtonText}" LineBreakMode="WordWrap" FontSize="24" Padding="2,0" SemanticProperties.Description="{Binding SaveDescription}"
                    FontFamily="InterSemiBold" VerticalOptions="Fill"
                    BackgroundColor="{DynamicResource Accent}"
                    TextColor="{DynamicResource OnAccent}"
                    BorderColor="Transparent" BorderWidth="0" CornerRadius="14"
                    Command="{Binding SaveCommand}">

            </Button>

            <Button Grid.Row="3" Grid.Column="0" Text="," Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter=","/>
            <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="0"/>
            <Button Grid.Row="3" Grid.Column="2" Text="00" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="00"/>
        </Grid>

        <!-- Тост «Сохранено»: занимает ВСЕ строки грида (без RowSpan живёт в строке баланса). -->
        <Border x:Name="SavedToast" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" Opacity="0"
                StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="18,10"
                BackgroundColor="{DynamicResource Accent}"
                HorizontalOptions="Center" VerticalOptions="End" Margin="16,0,16,16"
                InputTransparent="True">
            <Label Text="Сохранено" TextColor="{DynamicResource OnAccent}"
                   FontFamily="InterSemiBold" FontSize="14" />
        </Border>

    </Grid>

</ContentPage>
