<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.QuickAddPage"
             Title="{Binding ModeText}"
             Shell.NavBarIsVisible="False"
             Appearing="OnAppearing">

    <!-- Экран ввода по макету: шапка (всего + пилюля «в день до зарплаты»), сегмент,
         крупная сумма с кареткой, строка полей (магазин/счёт), сетка категорий 4×2,
         подкатегории лентой, клавиатура 4×3 с датой и кнопкой «Сохранить» справа.
         Навбар Shell скрыт (режим виден в сегменте) — иначе контент не влезает
         на устройство; клавиатура Auto с фикс. клавишами, наезды исключены. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6" Padding="14,10,14,10">

        <!-- Шапка: режим (при правке), баланс слева, пилюля «в день до зарплаты» справа. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="1">
                <Label Text="{Binding ModeText}" FontSize="12" FontFamily="InterSemiBold"
                       IsVisible="{Binding IsEditing}"
                       TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Всего" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label x:Name="BalanceLabel" Text="{Binding BalanceText}" FontSize="14" FontFamily="InterSemiBold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12,0,10,0" HeightRequest="32"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasPaydayHint}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPaydayCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding PaydayHintText}" FontSize="13" FontFamily="InterSemiBold"
                           TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                    <Label Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Сегмент: активная кнопка — карточка с рамкой, неактивные — прозрачные. -->
        <Border Grid.Row="1" Style="{StaticResource SegContainer}">
            <Grid x:Name="SegGrid" ColumnDefinitions="*,*,*" ColumnSpacing="3">
                <Button Grid.Column="0" Text="Расход" Style="{StaticResource SegButton}"
                        Command="{Binding SetExpenseCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsExpenseMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Доход" Style="{StaticResource SegButton}"
                        Command="{Binding SetIncomeCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsIncome}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="Перевод" Style="{StaticResource SegButton}"
                        Command="{Binding SetTransferCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTransfer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                            <Setter Property="BorderWidth" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- Сумма: знак по режиму, число, оранжевая каретка, ₽. Выравнивание вправо. -->
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="6" HeightRequest="48">
            <Label Text="{Binding SignText}" FontSize="30" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{Binding AmountDisplay}" FontSize="42" FontFamily="InterSemiBold" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
            <BoxView WidthRequest="2" HeightRequest="34" VerticalOptions="Center"
                     Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
            <Label Text="₽" FontSize="24" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
        </HorizontalStackLayout>

        <!-- Строка полей: магазин/заметка, счёт (и «куда» при переводе). -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{x:Static ctl:Glyphs.Search}" FontFamily="MaterialSymbolsRounded" FontSize="18"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Entry Text="{Binding MemoText}" Placeholder="Магазин или заметка"
                           BackgroundColor="Transparent" FontSize="15" MinimumHeightRequest="42"
                           ClearButtonVisibility="WhileEditing"/>
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Label Text="{x:Static ctl:Glyphs.CreditCard}" FontFamily="MaterialSymbolsRounded" FontSize="18"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Text="{Binding AccountPickerText}" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickAccountCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44"
                    IsVisible="{Binding IsTransfer}">
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Label Text="{x:Static ctl:Glyphs.SwapHoriz}" FontFamily="MaterialSymbolsRounded" FontSize="18"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Text="{Binding TargetPickerText}" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickTargetCommand}"/>
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- Категории: сетка 4×2, лента подкатегорий под ней. Блок лежит в компактном
             ScrollView без полосы: на низких экранах скроллится он, клавиатура
             и её цифры не сжимаются никогда. -->
        <ScrollView Grid.Row="4" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding CategoryLabelText}" FontSize="13" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Button Grid.Column="1" Text="Все" Style="{StaticResource GhostButton}" FontSize="13"
                            Command="{Binding OpenAllCategoriesCommand}"/>
                </Grid>

            <CollectionView ItemsSource="{Binding TopCategories}" HeightRequest="136"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4"
                                     HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChip">
                        <Border HeightRequest="64" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="4"
                                BackgroundColor="{AppThemeBinding Light={StaticResource KeyBgLight}, Dark={StaticResource KeyBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                                <Label Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                       FontFamily="MaterialSymbolsRounded" FontSize="22"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Name}" FontSize="11" LineBreakMode="TailTruncation"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="FontFamily" Value="InterSemiBold"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectRootCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Подкатегории выбранного корня: горизонтальная лента чипов. -->
            <CollectionView ItemsSource="{Binding SubCategories}" ItemsLayout="HorizontalList" HeightRequest="36"
                            HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding HasSubCategories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChip">
                        <Border StrokeShape="RoundRectangle 18" Padding="10,7" Margin="0,0,8,0" StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Name}" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectSubCommand, Source={RelativeSource AncestorType={x:Type vm:QuickAddViewModel}}}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Клавиатура 4×3: цифры, стирание, дата, «Сохранить» высотой в два ряда.
             Ряды Auto с фикс. высотой клавиш: экран любой высоты не обрезает цифры. -->
        <Grid x:Name="Keypad" Grid.Row="5" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="6" RowSpacing="6">
            <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="1"/>
            <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="2"/>
            <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="3"/>
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="backspace"
                    FontFamily="MaterialSymbolsRounded" FontSize="22" Text="{x:Static ctl:Glyphs.Delete}"/>

            <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="4"/>
            <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="5"/>
            <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="6"/>
            <!-- Дата: невидимый DatePicker ловит тап и открывает календарь,
                 подпись («Сегодня» / «25 окт») пишет Label — Format-literal
                 на Android DatePicker не отрисовывается. -->
            <Border Grid.Row="1" Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource KeyBgLight}, Dark={StaticResource KeyBgDark}}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="2" Padding="0,4">
                    <DatePicker Grid.Row="0" Grid.RowSpan="2" Date="{Binding Date}"
                                Opacity="0" BackgroundColor="Transparent" MinimumHeightRequest="0"
                                HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                    <Label Grid.Row="0" Text="{x:Static ctl:Glyphs.Calendar}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                           InputTransparent="True"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Label Grid.Row="1" Text="{Binding DateButtonText}" FontSize="11" InputTransparent="True"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                </Grid>
            </Border>

            <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="7"/>
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="8"/>
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="9"/>

            <Button x:Name="SaveButton" Grid.Row="2" Grid.RowSpan="2" Grid.Column="3"
                    Text="Сохранить" FontSize="14" Padding="2,0"
                    Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>

            <Button Grid.Row="3" Grid.Column="0" Text="," Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter=","/>
            <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="0"/>
            <Button Grid.Row="3" Grid.Column="2" Text="00" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="00"/>
        </Grid>

        <!-- Тост «Сохранено»: занимает ВСЕ строки грида (без RowSpan живёт в строке баланса). -->
        <Border x:Name="SavedToast" Grid.Row="0" Grid.RowSpan="6" IsVisible="False" Opacity="0"
                StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="18,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                HorizontalOptions="Center" VerticalOptions="End" Margin="16,0,16,16"
                InputTransparent="True">
            <Label Text="Сохранено" TextColor="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}"
                   FontFamily="InterSemiBold" FontSize="14" />
        </Border>

    </Grid>

</ContentPage>
