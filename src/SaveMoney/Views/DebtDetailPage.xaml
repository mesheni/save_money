<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.DebtDetailPage"
             Title="Долг"
             Appearing="OnAppearing">

    <CollectionView ItemsSource="{Binding Payments}" SelectionMode="None" VerticalScrollBarVisibility="Never">
        <CollectionView.Header>
        <VerticalStackLayout x:Name="RootStack" Padding="16,10,16,0" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PersonTitle}" FontSize="24" FontFamily="InterSemiBold"/>
                    <Label Text="{Binding DirectionText}" FontSize="13" Opacity="0.6"/>
                    <Label Text="{Binding RemainingText}" FontSize="30" FontFamily="InterBold"/>
                    <Label Text="{Binding TotalText, StringFormat='из {0}'}" FontSize="13" Opacity="0.6"/>
                    <Label Text="{Binding DueText}" FontSize="13" Opacity="0.6"/>
                    <Label Text="Долг закрыт" TextColor="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}" FontFamily="InterSemiBold"
                           IsVisible="{Binding IsSettled}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Платежи" Style="{StaticResource GroupLabel}"/>
        </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:PaymentRowVM">
                <Grid RowDefinitions="Auto,1" Padding="16,0">
                    <Grid Grid.Row="0" MinimumHeightRequest="48" Padding="0,4" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding DateText}" FontSize="15" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                        <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="15" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
        <VerticalStackLayout Padding="16,10" Spacing="14">

            <Button Text="Погасить долг" Style="{StaticResource PrimaryButton}" Command="{Binding RepayCommand}" IsVisible="{Binding CanRepay}"/>
            <VerticalStackLayout Spacing="10" IsVisible="{Binding CanReceivePayment}">
                <Label Text="Добавить платёж" Style="{StaticResource GroupLabel}"/>
                <Border Padding="12,0" MinimumHeightRequest="48">
                    <Entry Text="{Binding PaymentAmountText}" Placeholder="Сумма, ₽" Keyboard="Numeric" BackgroundColor="Transparent"/>
                </Border>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Дата" VerticalOptions="Center"/>
                    <Border Padding="12,0" MinimumHeightRequest="48">
                        <DatePicker Date="{Binding PaymentDate}" Format="d MMM yyyy"/>
                    </Border>
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding CanLinkTransaction}">
                    <Label Text="Провести по связанному счёту" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding CreateTransaction}" VerticalOptions="Center"/>
                </Grid>
                <Button Text="Добавить платёж" Style="{StaticResource PrimaryButton}" Command="{Binding AddPaymentCommand}"/>
                <Button Text="Закрыть досрочно" Style="{StaticResource GhostButton}" Command="{Binding SettleCommand}"/>
            </VerticalStackLayout>

            <Button Text="Править" Style="{StaticResource GhostButton}" Command="{Binding OpenEditCommand}"/>
            <Button Text="Удалить долг" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>

        </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>

</ContentPage>
