<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.DebtDetailPage"
             Title="Долг"
             Appearing="OnAppearing">

    <ScrollView>
        <VerticalStackLayout x:Name="RootStack" Padding="16,10" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PersonTitle}" FontSize="24" FontFamily="InterSemiBold"/>
                    <Label Text="{Binding DirectionText}" FontSize="13" Opacity="0.6"/>
                    <Label Text="{Binding RemainingText}" FontSize="30" FontFamily="InterBold"/>
                    <Label Text="{Binding TotalText, StringFormat='из {0}'}" FontSize="13" Opacity="0.6"/>
                    <Label Text="{Binding DueText}" FontSize="13" Opacity="0.6"/>
                    <Label Text="Долг закрыт ✓" TextColor="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}" FontFamily="InterSemiBold"
                           IsVisible="{Binding IsSettled}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Платежи" Style="{StaticResource GroupLabel}"/>
            <CollectionView ItemsSource="{Binding Payments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaymentRowVM">
                        <Border Style="{StaticResource ListRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding DateText}" Opacity="0.7" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsOpen}">
                <Label Text="Добавить платёж" Style="{StaticResource GroupLabel}"/>
                <Entry Text="{Binding PaymentAmountText}" Placeholder="Сумма, ₽" Keyboard="Text"/>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Дата" VerticalOptions="Center"/>
                    <DatePicker Date="{Binding PaymentDate}" Format="d MMM yyyy"/>
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding CanLinkTransaction}">
                    <Label Text="Провести по связанному счёту" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding CreateTransaction}" VerticalOptions="Center"/>
                </Grid>
                <Button Text="Добавить платёж" Style="{StaticResource PrimaryButton}" Command="{Binding AddPaymentCommand}"/>
                <Button Text="Закрыть досрочно" Style="{StaticResource GhostButton}" Command="{Binding SettleCommand}"/>
            </VerticalStackLayout>

            <Button Text="Править" Style="{StaticResource GhostButton}" Command="{Binding OpenEditCommand}"/>
            <Button Text="Удалить долг" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
