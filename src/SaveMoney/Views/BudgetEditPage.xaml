<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.BudgetEditPage"
             Title="{Binding Title}"
             Appearing="OnAppearing">

    <ScrollView>
        <VerticalStackLayout Padding="16,10" Spacing="12">

            <Label Text="Категория" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <Border Padding="12,0" MinimumHeightRequest="48">
                <ctl:MonetPicker ItemsSource="{Binding CategoryOptions}" SelectedIndex="{Binding CategoryIndex}" BackgroundColor="Transparent"/>
            </Border>
            <ctl:ValidationMessage Text="{Binding CategoryError}"/>

            <Label Text="Лимит на цикл, ₽" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <Border Padding="12,0" MinimumHeightRequest="48">
                <Entry Text="{Binding AmountText}" Placeholder="0" Keyboard="Numeric" BackgroundColor="Transparent"/>
            </Border>
            <ctl:ValidationMessage Text="{Binding AmountError}"/>

            <Button Text="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
