<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.RecurringPage"
             Title="Регулярные платежи"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить платёж" Command="{Binding AddCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{DynamicResource OnSurface}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid Padding="16,12">
        <CollectionView ItemsSource="{Binding Rows}">
        <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:RecurringRowVM">
                <Grid RowDefinitions="Auto,1">
                    <SwipeView Grid.Row="0">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Удалить" BackgroundColor="{DynamicResource Error}" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid MinimumHeightRequest="60" Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                              BackgroundColor="Transparent"
                              SemanticProperties.Hint="Открыть платёж для изменения">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding TitleText}" FontSize="16">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label FontSize="14" Text="{Binding SubText}"
                                       TextColor="{DynamicResource OnSurfaceVariant}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            <Label Text="{Binding AmountText}" FontSize="16" FontFamily="InterSemiBold"
                                   TextColor="{DynamicResource Income}"
                                   VerticalOptions="Center" HorizontalOptions="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
</VerticalStackLayout>

                            <Label Grid.Column="1" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" VerticalOptions="Center"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:RecurringViewModel}}}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
</Border>
                    </SwipeView>

                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

        <Label Text="Регулярных платежей нет — добавьте первый кнопкой сверху"
               IsVisible="{Binding HasNoRows}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{DynamicResource OnSurfaceVariant}"/>
    </Grid>

</ContentPage>
