<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.BudgetsPage"
             Title="Бюджеты"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить лимит" Command="{Binding AddCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{DynamicResource OnSurface}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,12">

        <Label Grid.Row="0" Text="{Binding CycleText}" FontFamily="InterSemiBold" Padding="4,6,0,8"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BudgetRowVM">
                    <Grid RowDefinitions="Auto,1">
                        <SwipeView Grid.Row="0">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Удалить" BackgroundColor="{DynamicResource Error}" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<VerticalStackLayout Padding="16" Spacing="7" MinimumHeightRequest="64"
                                                 BackgroundColor="Transparent"
                                                 SemanticProperties.Hint="Открыть лимит для изменения">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                                    <Label Grid.ColumnSpan="3" FontSize="16">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Icon, Converter={StaticResource IconGlyph}}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18"/>
                                                <Span Text="  "/>
                                                <Span Text="{Binding Name}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding PercentText}" FontSize="14"
                                           TextColor="{DynamicResource OnSurfaceVariant}" Margin="8,0" VerticalOptions="Center"/>
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalOptions="End" Text="{Binding FactText}" FontSize="16" FontFamily="InterSemiBold"/>
                                </Grid>
                                <ctl:AnimatedProgressBar Progress="{Binding Progress}" HeightRequest="6"
                                             ProgressColor="{DynamicResource Income}">
                                    <ProgressBar.Triggers>
                                        <DataTrigger TargetType="ProgressBar" Binding="{Binding IsOver}" Value="True">
                                            <Setter Property="ProgressColor" Value="{DynamicResource Error}"/>
                                        </DataTrigger>
                                    </ProgressBar.Triggers>
                                </ctl:AnimatedProgressBar>
                                <Label Text="{Binding PlanText}" FontSize="14"
                                       TextColor="{DynamicResource Income}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOver}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:BudgetsViewModel}}}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </VerticalStackLayout>
</Border>
                        </SwipeView>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Text="Бюджетов пока нет — задайте первый лимит кнопкой сверху"
               IsVisible="{Binding HasNoBudgets}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{DynamicResource OnSurfaceVariant}"/>

    </Grid>

</ContentPage>
