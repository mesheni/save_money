<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:conv="clr-namespace:SaveMoney.Converters"
             x:Class="SaveMoney.Views.BudgetsPage"
             Title="Бюджеты"
             Appearing="OnAppearing">

    <ContentPage.Resources>
        <conv:BoolToColorConverter x:Key="OverColor" TrueColor="#E74C3C" FalseColor="#2ECC71"/>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋" Command="{Binding AddCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12,6">

        <Label Grid.Row="0" Text="{Binding CycleText}" FontAttributes="Bold" Padding="4,6,0,8"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BudgetRowVM">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Удалить" BackgroundColor="#E74C3C" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <VerticalStackLayout Padding="6,10" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="{Binding PercentText}" FontSize="12" Opacity="0.6" Margin="8,0"/>
                                <Label Grid.Column="2" Text="{Binding FactText}" FontAttributes="Bold"/>
                            </Grid>
                            <ProgressBar Progress="{Binding Progress}" HeightRequest="4"/>
                            <Label Text="{Binding PlanText}" FontSize="12"
                                   TextColor="{Binding IsOver, Converter={StaticResource OverColor}}"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:BudgetsViewModel}}}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </VerticalStackLayout>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1" Text="Бюджетов пока нет — нажмите ＋, чтобы задать лимит"
               IsVisible="{Binding !HasBudgets}" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.5"/>

    </Grid>

</ContentPage>
