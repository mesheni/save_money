<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.MorePage"
             Title="Ещё">

    <Grid RowDefinitions="*,Auto" Padding="14,6">

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" VerticalOptions="Start">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoreMenuItem">
                        <Grid Padding="14,12" ColumnDefinitions="38,*,Auto,8" ColumnSpacing="12">
                            <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftBgLight}, Dark={StaticResource SoftBgDark}}">
                                <Label Text="{Binding Emoji}" FontSize="19"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"/>
                                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedText}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="17"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <Label Grid.Row="1" Text="{Binding VersionText}" HorizontalOptions="Center"
               Style="{StaticResource MutedText}" Padding="0,10"/>

    </Grid>

</ContentPage>
