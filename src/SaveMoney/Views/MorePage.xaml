<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.MorePage"
             Title="Ещё"
             Shell.NavBarIsVisible="False">

    <!-- Экран по макету: три группы (Деньги / Планирование / Приложение) — плоские
         строки с иконкой без плитки, живой подписью и разделителями. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Padding="16,12,16,0">

        <Label Grid.Row="0" Text="Ещё" Style="{StaticResource ScreenTitle}" Margin="0,0,0,8"/>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <Label Text="Финансы" FontSize="14"
                       TextColor="{DynamicResource OnSurfaceVariant}"
                       Margin="0,8,0,4"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MoneyItems}" IsEnabled="True">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoreMenuItem">
                            <Grid RowDefinitions="Auto,1">
                                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid  MinimumHeightRequest="60" Padding="16,12" ColumnSpacing="14" ColumnDefinitions="24,*,Auto"
                                      BackgroundColor="Transparent"
                                      SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="Открыть раздел">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Label Grid.Column="0" Text="{Binding IconKey, Converter={StaticResource IconGlyph}}"
                                           FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24" VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurface}"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="16"/>
                                        <Label Text="{Binding Subtitle}" FontSize="14" LineBreakMode="WordWrap">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                                                    <Setter Property="FontFamily" Value="InterSemiBold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" IsVisible="{Binding IsEnabled}"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                    <Button Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                            IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}"
                                            SemanticProperties.Hint="Открыть раздел"/>
                                </Grid>
</Border>

                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Планирование" FontSize="14"
                       TextColor="{DynamicResource OnSurfaceVariant}"
                       Margin="0,20,0,4"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanningItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoreMenuItem">
                            <Grid RowDefinitions="Auto,1">
                                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid  MinimumHeightRequest="60" Padding="16,12" ColumnSpacing="14" ColumnDefinitions="24,*,Auto"
                                      BackgroundColor="Transparent"
                                      SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="Открыть раздел">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Label Grid.Column="0" Text="{Binding IconKey, Converter={StaticResource IconGlyph}}"
                                           FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24" VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurface}"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="16"/>
                                        <Label Text="{Binding Subtitle}" FontSize="14" LineBreakMode="WordWrap">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                                                    <Setter Property="FontFamily" Value="InterSemiBold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" IsVisible="{Binding IsEnabled}"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                    <Button Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                            IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}"
                                            SemanticProperties.Hint="Открыть раздел"/>
                                </Grid>
</Border>

                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Приложение" FontSize="14"
                       TextColor="{DynamicResource OnSurfaceVariant}"
                       Margin="0,20,0,4"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AppItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoreMenuItem">
                            <Grid RowDefinitions="Auto,1">
                                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid  MinimumHeightRequest="60" Padding="16,12" ColumnSpacing="14" ColumnDefinitions="24,*,Auto"
                                      BackgroundColor="Transparent"
                                      SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="Открыть раздел">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Label Grid.Column="0" Text="{Binding IconKey, Converter={StaticResource IconGlyph}}"
                                           FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24" VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurface}"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="16"/>
                                        <Label Text="{Binding Subtitle}" FontSize="14" LineBreakMode="WordWrap"
                                               TextColor="{DynamicResource OnSurfaceVariant}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" IsVisible="{Binding IsEnabled}"
                                           VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                    <Button Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                            IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}"
                                            SemanticProperties.Hint="Открыть раздел"/>
                                </Grid>
</Border>

                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="2" Text="{Binding VersionText}" HorizontalOptions="Center"
               Style="{StaticResource MutedText}" Padding="0,10"/>

    </Grid>

</ContentPage>
