<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SaveMoney.Views.ReportsPage"
             Title="Отчёты"
             Shell.NavBarIsVisible="False"
             Appearing="OnAppearing">

    <!-- Экран по макету: заголовок + пилюля периода, сегмент расходы/доходы,
         кольцо + сумма с дельтой к прошлому периоду, топ категорий, столбики по дням. -->
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout x:Name="RootStack" Padding="16,12,16,16" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Отчёты" Style="{StaticResource ScreenTitle}" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="{Binding PeriodPillText}" Command="{Binding PickPeriodCommand}"
                        Style="{StaticResource GhostButton}" CornerRadius="24" Padding="14,8" BorderWidth="1"
                        BorderColor="{DynamicResource OutlineVariant}"
                        BackgroundColor="{DynamicResource SurfaceContainerLow}"
                        SemanticProperties.Hint="Выбрать период отчёта" VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding PeriodPillActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Свой период: два DatePicker вместо календаря ActionSheet. -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsCustom}">
                <Border StrokeShape="RoundRectangle 12" Padding="10,0" MinimumHeightRequest="48">
                    <DatePicker Date="{Binding FromDate}" Format="d MMM yy" FontSize="14" SemanticProperties.Description="Начало периода отчёта"
                                BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Border>
                <Label Grid.Column="1" Text="—" VerticalOptions="Center"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Padding="10,0" MinimumHeightRequest="48">
                    <DatePicker Date="{Binding ToDate}" Format="d MMM yy" FontSize="14" SemanticProperties.Description="Конец периода отчёта"
                                BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Сегмент расходы/доходы. -->
            <Border Style="{StaticResource SegContainer}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                    <Button Grid.Column="0" Text="Расходы" Style="{StaticResource SegButton}"
                            Command="{Binding ShowExpensesCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsExpenses}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="BorderColor" Value="{DynamicResource OutlineVariant}"/>
                                <Setter Property="BorderWidth" Value="1"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Доходы" Style="{StaticResource SegButton}"
                            Command="{Binding ShowIncomesCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsIncomes}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryContainer}"/>
                                <Setter Property="TextColor" Value="{DynamicResource OnSecondaryContainer}"/>
                                <Setter Property="BorderColor" Value="{DynamicResource OutlineVariant}"/>
                                <Setter Property="BorderWidth" Value="1"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Кольцо + итог с дельтой и средним. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
<VerticalStackLayout Spacing="10" IsVisible="{Binding HasData}">
                <lvc:PieChart x:Name="DonutChart" Series="{Binding PieSeries}"
                              WidthRequest="104" HeightRequest="104" HorizontalOptions="Center"
                              SemanticProperties.Description="Диаграмма распределения операций по категориям"/>
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding PeriodTotalCaption}" FontSize="14"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Label Text="{Binding PeriodTotalText}" FontSize="30" FontFamily="InterBold"/>
                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasDelta}">
                        <Label Text="{Binding DeltaText}" FontSize="14" FontFamily="InterSemiBold"
                               TextColor="{DynamicResource Error}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding DeltaGood}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Income}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                    <Label Text="{Binding AvgPerDayText}" FontSize="14" Margin="0,4,0,0"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
</Border>

            <Label Text="Нет операций за период" IsVisible="{Binding HasNoData}" HorizontalOptions="Center"
                   TextColor="{DynamicResource OnSurfaceVariant}"/>

            <!-- Топ категорий: цветной квадрат, сумма с процентом, полоска. -->
            <VerticalStackLayout Spacing="0" IsVisible="{Binding HasData}">
                <Label Text="Топ категорий" FontSize="14"
                       TextColor="{DynamicResource OnSurfaceVariant}"
                       Margin="0,0,0,4"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TopCategoryRow">
                            <Grid MinimumHeightRequest="52" Padding="0,4" ColumnSpacing="10" ColumnDefinitions="12,*" RowDefinitions="Auto,Auto,Auto">
                                <BoxView Grid.RowSpan="3" Grid.Column="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,7,0,0"
                                         Color="{Binding BarColor}"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="16" LineBreakMode="WordWrap"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding AmountText}" FontSize="16" FontFamily="InterSemiBold" LineBreakMode="NoWrap"/>
                                    <Label Grid.Column="1" Text="{Binding PercentText}" FontSize="14"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                </Grid>
                                <Border Grid.Row="2" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{DynamicResource SurfaceContainer}"
                                            HeightRequest="6" Padding="0" HorizontalOptions="Fill">
                                        <ctl:AnimatedProgressBar Progress="{Binding Progress}" HeightRequest="6"
                                                                 ProgressColor="{Binding BarColor}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- По дням: мини-диаграмма без осей; последний день — акцентный. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasData}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding DaysCaption}" FontSize="14" VerticalOptions="Center"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Button Grid.Column="1" Text="Скачать CSV" Style="{StaticResource GhostButton}" FontSize="14"
                            Command="{Binding ExportCsvCommand}"/>
                </Grid>
                <Label Text="{Binding DayChartHint}" Style="{StaticResource MutedText}"/>
                <ScrollView x:Name="DayChartScroll" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <lvc:CartesianChart x:Name="DaysChart" Series="{Binding DaySeries}"
                                    XAxes="{Binding DayXAxes}" YAxes="{Binding DayYAxes}"
                                    WidthRequest="{Binding DayChartWidth}" HeightRequest="232"
                                    SizeChanged="OnDaysChartSizeChanged"
                                    SemanticProperties.Description="График сумм с датами под каждым столбцом"/>
                </ScrollView>
                <Label Text="Периоды с операциями" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                <CollectionView ItemsSource="{Binding DailyRows}" HeightRequest="{Binding DailyRowsHeight}" SelectionMode="None"
                                VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DailyReportRow">
                            <Grid MinimumHeightRequest="48" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding DateText}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
