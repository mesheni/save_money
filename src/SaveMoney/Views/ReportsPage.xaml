<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SaveMoney.Views.ReportsPage"
             Title="Отчёты"
             Shell.NavBarIsVisible="False"
             Appearing="OnAppearing">

    <!-- Экран по макету: заголовок + пилюля периода, сегмент расходы/доходы,
         кольцо + сумма с дельтой к прошлому периоду, топ категорий, столбики по дням. -->
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout x:Name="RootStack" Padding="16,12,16,16" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Отчёты" Style="{StaticResource ScreenTitle}" VerticalOptions="Center"/>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 18" Padding="14,0,10,0" HeightRequest="36"
                        StrokeThickness="1" VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding PeriodPillActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"/>
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding PeriodPillText}" FontSize="14" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding PeriodPillActive}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                                    <Setter Property="FontFamily" Value="InterSemiBold"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{x:Static ctl:Glyphs.ChevronDown}" FontFamily="MaterialSymbolsRounded" FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPeriodCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Свой период: два DatePicker вместо календаря ActionSheet. -->
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCustom}">
                <Border StrokeShape="RoundRectangle 12" Padding="10,0" HeightRequest="40">
                    <DatePicker Date="{Binding FromDate}" Format="d MMM yy" FontSize="14"
                                BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Border>
                <Label Text="—" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                <Border StrokeShape="RoundRectangle 12" Padding="10,0" HeightRequest="40">
                    <DatePicker Date="{Binding ToDate}" Format="d MMM yy" FontSize="14"
                                BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Сегмент расходы/доходы. -->
            <Border Style="{StaticResource SegContainer}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                    <Button Grid.Column="0" Text="Расходы" Style="{StaticResource SegButton}"
                            Command="{Binding ShowExpensesCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsExpenses}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                                <Setter Property="BorderWidth" Value="1"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Доходы" Style="{StaticResource SegButton}"
                            Command="{Binding ShowIncomesCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsIncomes}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                                <Setter Property="BorderWidth" Value="1"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Кольцо + итог с дельтой и средним. -->
            <Grid ColumnDefinitions="136,*" ColumnSpacing="16" IsVisible="{Binding HasData}">
                <lvc:PieChart x:Name="DonutChart" Grid.Column="0" Series="{Binding PieSeries}"
                              WidthRequest="136" HeightRequest="136"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding PeriodTotalCaption}" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Text="{Binding PeriodTotalText}" FontSize="30" FontFamily="InterBold"/>
                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasDelta}">
                        <Label Text="{Binding DeltaText}" FontSize="13" FontFamily="InterSemiBold"
                               TextColor="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding DeltaGood}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                    <Label Text="{Binding AvgPerDayText}" FontSize="13" Margin="0,4,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Нет операций за период" IsVisible="{Binding HasNoData}" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>

            <!-- Топ категорий: цветной квадрат, сумма с процентом, полоска. -->
            <VerticalStackLayout Spacing="0" IsVisible="{Binding HasData}">
                <Label Text="Топ категорий" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,0,0,4"/>
                <CollectionView ItemsSource="{Binding TopRows}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TopCategoryRow">
                            <Grid HeightRequest="52" ColumnSpacing="12" ColumnDefinitions="12,*">
                                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"
                                         Color="{Binding BarColor}"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="15"/>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding AmountText}" FontSize="15" FontFamily="InterSemiBold"/>
                                            <Label Text="{Binding PercentText}" FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SoftBgLight}, Dark={StaticResource SoftBgDark}}"
                                            HeightRequest="6" Padding="0" HorizontalOptions="Fill">
                                        <ctl:AnimatedProgressBar Progress="{Binding Progress}" HeightRequest="6"
                                                                 ProgressColor="{Binding BarColor}"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- По дням: мини-диаграмма без осей; последний день — акцентный. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasData}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding DaysCaption}" FontSize="13" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Button Grid.Column="1" Text="Скачать CSV" Style="{StaticResource GhostButton}" FontSize="13"
                            Command="{Binding ExportCsvCommand}"/>
                </Grid>
                <lvc:CartesianChart x:Name="DaysChart" Series="{Binding DaySeries}"
                                    XAxes="{Binding DayXAxes}" YAxes="{Binding DayYAxes}"
                                    HeightRequest="64"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
