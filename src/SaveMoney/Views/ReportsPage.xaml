<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SaveMoney.Views.ReportsPage"
             Title="Отчёты"
             Appearing="OnAppearing">

    <ScrollView>
        <VerticalStackLayout x:Name="RootStack" Padding="14,6" Spacing="12">

            <!-- FlexLayout с переносом: на узких экранах «Свой период» с двумя DatePicker не обрезается -->
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Picker ItemsSource="{Binding PeriodOptions}" SelectedIndex="{Binding PeriodIndex}" WidthRequest="140" Margin="0,0,8,0"/>
                <DatePicker Date="{Binding FromDate}" Format="d MMM yy" IsVisible="{Binding IsCustom}" Margin="0,0,8,0"/>
                <DatePicker Date="{Binding ToDate}" Format="d MMM yy" IsVisible="{Binding IsCustom}"/>
            </FlexLayout>

            <Border Style="{StaticResource Card}" Padding="18,16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Расход за период" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                    <Label x:Name="PeriodExpenseLabel" Text="{Binding PeriodExpenseText}" FontSize="30" FontFamily="InterSemiBold"/>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,10,0,10"/>
                    <Label Text="{Binding SummaryText}" FontSize="13.5" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasData}" Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="По категориям" Style="{StaticResource CardTitle}"/>
                    <!-- Donut: итог расхода — в центре кольца, как в макете Vibrant -->
                    <Grid HeightRequest="220">
                        <lvc:PieChart x:Name="DonutChart" Series="{Binding PieSeries}" HeightRequest="220"/>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" Spacing="1">
                            <Label Text="{Binding PeriodExpenseText}" FontSize="16" FontFamily="InterBold" HorizontalOptions="Center"/>
                            <Label Text="расход за период" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Динамика" Style="{StaticResource CardTitle}"/>
                    <lvc:CartesianChart x:Name="DynamicsChart" Series="{Binding ColumnSeries}"
                                        XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                        HeightRequest="200"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasData}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Топ категорий" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                    <CollectionView ItemsSource="{Binding TopRows}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TopCategoryRow">
                                <VerticalStackLayout Padding="0,6" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Label Text="{Binding Display}"/>
                                        <Label Grid.Column="1" Text="{Binding PercentText}" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" Margin="8,0"/>
                                        <Label Grid.Column="2" Text="{Binding AmountText}" FontFamily="InterSemiBold"/>
                                    </Grid>
                                    <ctl:AnimatedProgressBar Progress="{Binding Progress}" HeightRequest="7"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="Экспорт CSV за период" Style="{StaticResource PrimaryButton}"
                    Margin="0,4,0,12" Command="{Binding ExportCsvCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
