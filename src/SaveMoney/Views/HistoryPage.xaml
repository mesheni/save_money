<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.HistoryPage"
             Title="История"
             Shell.NavBarIsVisible="False"
             Appearing="OnAppearing">

    <!-- Экран по макету: заголовок + поиск, пилюли-фильтры (период/счёт/категории),
         сводка «доход / расход / разница», группы дней с итогом, плоские строки. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Padding="16,12,16,8">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="История" Style="{StaticResource ScreenTitle}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="{x:Static ctl:Glyphs.Search}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24"
                    WidthRequest="48" MinimumHeightRequest="48" Padding="0" BackgroundColor="Transparent" BorderWidth="0"
                    Command="{Binding ToggleSearchCommand}" SemanticProperties.Description="Показать поиск операций"/>
        </Grid>

        <!-- Строка поиска: появляется по тапу на лупу. -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 12" Padding="12,0" MinimumHeightRequest="48"
                IsVisible="{Binding IsSearchVisible}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                <Label Text="{x:Static ctl:Glyphs.Search}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Поиск по операциям"
                       BackgroundColor="Transparent" FontSize="16" MinimumHeightRequest="48"
                       SemanticProperties.Description="Поиск операций"/>
            </Grid>
        </Border>

        <!-- Пилюли-фильтры: активная подсвечивается. -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
          <HorizontalStackLayout Spacing="8">
            <Button Text="{Binding PeriodPillText}" Command="{Binding PickPeriodCommand}" Style="{StaticResource GhostButton}"
                    CornerRadius="24" Padding="14,8" BorderWidth="1" BorderColor="{DynamicResource OutlineVariant}"
                    BackgroundColor="{DynamicResource SurfaceContainerLow}"
                    SemanticProperties.Hint="Выбрать период">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding PeriodPillActive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="{Binding AccountPillText}" Command="{Binding PickAccountCommand}" Style="{StaticResource GhostButton}"
                    CornerRadius="24" Padding="14,8" BorderWidth="1" BorderColor="{DynamicResource OutlineVariant}"
                    BackgroundColor="{DynamicResource SurfaceContainerLow}"
                    SemanticProperties.Hint="Фильтр по счёту">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding AccountPillActive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="{Binding CategoryPillText}" Command="{Binding PickCategoryCommand}" Style="{StaticResource GhostButton}"
                    CornerRadius="24" Padding="14,8" BorderWidth="1" BorderColor="{DynamicResource OutlineVariant}"
                    BackgroundColor="{DynamicResource SurfaceContainerLow}"
                    SemanticProperties.Hint="Фильтр по категории">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding CategoryPillActive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainer}"/>
                        <Setter Property="BorderColor" Value="{DynamicResource Primary}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
          </HorizontalStackLayout>
        </ScrollView>

        <!-- Сводка периода: доход / расход / разница. -->
        <VerticalStackLayout Grid.Row="3" Spacing="4" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Доход" FontSize="14" VerticalOptions="Center"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Label Grid.Column="1" Text="{Binding IncomeSummaryText}" FontSize="14" FontFamily="InterSemiBold"
                       LineBreakMode="NoWrap" HorizontalOptions="End"
                       TextColor="{DynamicResource Income}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Расход" FontSize="14" VerticalOptions="Center"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Label Grid.Column="1" Text="{Binding ExpenseSummaryText}" FontSize="14" FontFamily="InterSemiBold"
                       LineBreakMode="NoWrap" HorizontalOptions="End"
                       TextColor="{DynamicResource Error}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Разница" FontSize="14" VerticalOptions="Center"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Label Grid.Column="1" Text="{Binding DiffSummaryText}" FontSize="14" FontFamily="InterSemiBold"
                       LineBreakMode="NoWrap" HorizontalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="4" ItemsSource="{Binding Groups}" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:HistoryGroupVM">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48" Padding="0,12,0,4">
                        <Label Grid.Column="0" Text="{Binding HeaderTitleText}" FontFamily="InterSemiBold" FontSize="14"
                               VerticalOptions="End"/>
                        <Label Grid.Column="1" Text="{Binding DayTotalText}" FontSize="14" VerticalOptions="End"
                               TextColor="{DynamicResource OnSurfaceVariant}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemVM">
                    <Grid RowDefinitions="Auto,1">
                        <SwipeView Grid.Row="0">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Удалить" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid MinimumHeightRequest="60" ColumnSpacing="10" ColumnDefinitions="40,*,Auto" Padding="16,12"
                                  BackgroundColor="Transparent"
                                  SemanticProperties.Hint="Открыть операцию для изменения">
                                <Border Grid.Column="0" WidthRequest="40" MinimumHeightRequest="48" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20" HorizontalOptions="Start" VerticalOptions="Center"
                                        BackgroundColor="{DynamicResource SurfaceContainer}">
                                    <Label Text="{Binding Icon, Converter={StaticResource IconGlyph}}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False"
                                           FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{DynamicResource OnSurface}"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="16" FontFamily="InterSemiBold"/>
                                    <Label Text="{Binding Subtitle}" FontSize="14"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Label Text="{Binding AmountText}" FontSize="14" FontFamily="InterSemiBold" LineBreakMode="WordWrap"
                                       VerticalOptions="Center" HorizontalOptions="End"
                                       TextColor="{DynamicResource Income}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Error}"/>


                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsNeutral}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" VerticalOptions="Center"
                                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
</Border>
                        </SwipeView>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4" Text="{Binding EmptyStateText}"
               IsVisible="{Binding HasNoRows}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{DynamicResource OnSurfaceVariant}"/>

    </Grid>

</ContentPage>
