<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:conv="clr-namespace:SaveMoney.Converters"
             x:Class="SaveMoney.Views.HistoryPage"
             Title="История"
             Appearing="OnAppearing">

    <Grid RowDefinitions="Auto,Auto,*" Padding="14,6">

        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Picker ItemsSource="{Binding PeriodOptions}" SelectedIndex="{Binding PeriodIndex}" WidthRequest="120"/>

    <ContentPage.Resources>
        <conv:BoolToColorConverter x:Key="AmountColor"
                                        TrueColor="#E05357" TrueColorDark="#F58C8F"
                                        FalseColor="#2FA45D" FalseColorDark="#6FD597"/>
    </ContentPage.Resources>
            <Picker ItemsSource="{Binding AccountOptions}" SelectedIndex="{Binding AccountIndex}" WidthRequest="160"/>
        </HorizontalStackLayout>

        <Label Grid.Row="1" Text="{Binding SummaryText}" Padding="4,8,0,2"
               Style="{StaticResource MutedText}" FontSize="13"/>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Groups}" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:HistoryGroupVM">
                    <Border Style="{StaticResource DayHeader}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding HeaderText}" FontAttributes="Bold" FontSize="13"/>
                            <Label Grid.Column="1" Text="{Binding IncomeText}" TextColor="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}"
                                   FontSize="13" FontAttributes="Bold" Margin="10,0"/>
                            <Label Grid.Column="2" Text="{Binding ExpenseText}" TextColor="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}"
                                   FontSize="13" FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemVM">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Удалить" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="8,10" ColumnDefinitions="44,*,Auto">
                            <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Title}" FontAttributes="Bold"/>
                                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedText}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding AmountText}" FontAttributes="Bold" TextColor="{Binding IsExpense, Converter={StaticResource AmountColor}}"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" Text="Пока пусто — добавьте первую операцию на вкладке «Ввод»"
               IsVisible="{Binding !HasItems}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>

    </Grid>

</ContentPage>
