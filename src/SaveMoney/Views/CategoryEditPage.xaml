<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.CategoryEditPage"
             Title="{Binding Title}"
             Appearing="OnAppearing">

    <ScrollView>
        <VerticalStackLayout Padding="16,10" Spacing="12">

            <Label Text="Название" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <Border Padding="12,0" MinimumHeightRequest="48">
                <Entry Text="{Binding Name}" Placeholder="Например, Хобби" BackgroundColor="Transparent"/>
            </Border>
            <ctl:ValidationMessage Text="{Binding NameError}"/>

            <Label Text="Иконка" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}"/>
            <ctl:AppearancePicker IsColorPicker="False" ItemsSource="{Binding Icons}" SelectionCommand="{Binding SelectIconCommand}"/>

            <Button Text="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
