<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.DebtsPage"
             Title="Долги"
             Appearing="OnAppearing">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить долг" Command="{Binding AddCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static ctl:Glyphs.Add}" FontFamily="MaterialSymbolsRounded" Size="20"
                                 Color="{DynamicResource OnSurface}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12">

        <ctl:MonetPicker Grid.Row="0" ItemsSource="{Binding DirectionOptions}" SelectedIndex="{Binding DirectionIndex}"
                WidthRequest="160" HorizontalOptions="Start"/>

        <Label Grid.Row="1" Text="{Binding SummaryText}" FontFamily="InterSemiBold" Padding="4,8,0,4"/>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DebtRowVM">
                    <Grid RowDefinitions="Auto,1">
                        <SwipeView Grid.Row="0">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem IsVisible="{Binding IsPersonalDebt}" Text="Удалить" BackgroundColor="{DynamicResource Error}" Invoked="OnDeleteInvoked" CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
<Grid MinimumHeightRequest="64" Padding="16,12" ColumnDefinitions="24,*,Auto" ColumnSpacing="10"
                                  BackgroundColor="Transparent"
                                  SemanticProperties.Hint="Открыть долг">
                                <Label Grid.Column="0" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24"
                                       TextColor="{DynamicResource OnSurface}"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding PersonName}" FontSize="16"/>
                                    <Label Text="{Binding Subtitle}" FontSize="14"
                                           TextColor="{DynamicResource OnSurfaceVariant}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <ctl:AnimatedProgressBar IsVisible="{Binding IsPersonalDebt}" Progress="{Binding Progress}" HeightRequest="4"
                                                 HorizontalOptions="Fill" VerticalOptions="Center"/>
                                <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding RemainingText}" FontSize="16" FontFamily="InterSemiBold"/>
                                    <Label IsVisible="{Binding IsPersonalDebt}" Text="{Binding TotalText}" FontSize="14"
                                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                                </VerticalStackLayout>
</VerticalStackLayout>

                                <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" VerticalOptions="Center"
                                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:DebtsViewModel}}}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
</Border>
                        </SwipeView>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" Text="Долгов нет — добавьте первый кнопкой сверху"
               IsVisible="{Binding HasNoRows}" VerticalOptions="Center" HorizontalOptions="Center"
               TextColor="{DynamicResource OnSurfaceVariant}"/>

    </Grid>

</ContentPage>
