<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:svc="clr-namespace:SaveMoney.Core.Services;assembly=SaveMoney.Core"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.PaydayPage"
             Title="До зарплаты"
             Shell.NavBarIsVisible="False">

    <!-- Экран по макету: прогноз «можно тратить», прогресс цикла, разбивка,
         предстоящие платежи, блок бюджетов, настройки внизу. -->
    <ScrollView>
        <VerticalStackLayout x:Name="RootStack" Padding="16,12,16,16" Spacing="16">

            <!-- Шапка: назад + заголовок. -->
            <Grid ColumnDefinitions="Auto,*" Margin="-8,0,0,0">
                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                        BackgroundColor="Transparent">
                    <Label Text="{x:Static ctl:Glyphs.ArrowBack}" FontFamily="MaterialSymbolsRounded" FontSize="24"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1" Text="До зарплаты" Style="{StaticResource PageTitle}" VerticalOptions="Center"/>
            </Grid>

            <!-- Прогноз. -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding PaydayEndText}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                <Label Text="{Binding CanSpendText}" FontSize="48" FontFamily="InterBold">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CanSpendNegative}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{Binding PerDayText}" FontSize="15" FontFamily="InterSemiBold"
                           TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"/>
                    <Label Text="{Binding DaysLeftText}" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Прогресс цикла. -->
            <VerticalStackLayout Spacing="6">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" HeightRequest="8" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftBgLight}, Dark={StaticResource SoftBgDark}}">
                    <ctl:AnimatedProgressBar Progress="{Binding CycleProgress}" HeightRequest="8"
                                             ProgressColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                </Border>
                <Grid ColumnDefinitions="*,Auto,*">
                    <Label Grid.Column="0" Text="{Binding CycleStartText}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Grid.Column="1" Text="{Binding CycleProgressText}" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Grid.Column="2" Text="{Binding CycleEndText}" FontSize="12" HorizontalOptions="End"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Разбивка: остаток и платежи до зарплаты. -->
            <VerticalStackLayout Spacing="0">
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                <Grid HeightRequest="40" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Остаток на счетах" FontSize="15" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding BalanceText}" FontSize="15" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                <Grid HeightRequest="40" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Платежи до зарплаты" FontSize="15" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding UpcomingTotalText}" FontSize="15" FontFamily="InterSemiBold" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasUpcomingTotal}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
            </VerticalStackLayout>

            <!-- Предстоящие платежи. -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Предстоящие платежи" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,0,0,2"/>
                <VerticalStackLayout IsVisible="{Binding HasUpcomingItems}" BindableLayout.ItemsSource="{Binding UpcomingItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpcomingPaymentRow">
                            <Grid HeightRequest="36" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Title}" FontSize="15" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding DateText}" FontSize="13" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Label Grid.Column="2" Text="{Binding AmountText}" FontSize="15" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Предстоящих платежей до зарплаты нет" FontSize="13"
                       IsVisible="{Binding HasNoUpcomingItems}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
            </VerticalStackLayout>

            <!-- Бюджеты. -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding BudgetCycleText}" FontSize="13" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Button Grid.Column="1" Text="Добавить" Style="{StaticResource GhostButton}" FontSize="13"
                            Command="{Binding AddBudgetCommand}"/>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding HasBudgets}" BindableLayout.ItemsSource="{Binding BudgetItems}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:BudgetStatusRow">
                            <VerticalStackLayout Padding="0,8,0,10" Spacing="7">
                                <BoxView HeightRequest="1" Margin="0,-8,0,0"
                                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding FactText}" FontSize="15" FontFamily="InterSemiBold"/>
                                        <Label Text="{Binding PlanText}" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 3" HeightRequest="6" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftBgLight}, Dark={StaticResource SoftBgDark}}">
                                    <ctl:AnimatedProgressBar Progress="{Binding Percent}" HeightRequest="6"
                                                             ProgressColor="{AppThemeBinding Light={StaticResource IncomeLight}, Dark={StaticResource IncomeDark}}">
                                        <ctl:AnimatedProgressBar.Triggers>
                                            <DataTrigger TargetType="ctl:AnimatedProgressBar" Binding="{Binding IsOver}" Value="True">
                                                <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource ExpenseLight}, Dark={StaticResource ExpenseDark}}"/>
                                            </DataTrigger>
                                        </ctl:AnimatedProgressBar.Triggers>
                                    </ctl:AnimatedProgressBar>
                                </Border>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static ctl:Glyphs.Warning}" FontFamily="MaterialSymbolsRounded" FontSize="14" VerticalOptions="Center"
                                           IsVisible="{Binding IsOver}"
                                           TextColor="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}"/>
                                    <Label Text="{Binding OverText}" FontSize="12" FontFamily="InterSemiBold" VerticalOptions="Center"
                                           IsVisible="{Binding IsOver}"
                                           TextColor="{AppThemeBinding Light={StaticResource ExpenseTextLight}, Dark={StaticResource ExpenseTextDark}}"/>
                                    <Label Text="{x:Static ctl:Glyphs.Check}" FontFamily="MaterialSymbolsRounded" FontSize="14" VerticalOptions="Center"
                                           IsVisible="{Binding IsWithinLimit}"
                                           TextColor="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}"/>
                                    <Label Text="{Binding OkText}" FontSize="12" FontFamily="InterSemiBold" VerticalOptions="Center"
                                           IsVisible="{Binding IsWithinLimit}"
                                           TextColor="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Лимиты не заданы" FontSize="13" IsVisible="{Binding HasNoBudgets}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
            </VerticalStackLayout>

            <!-- Настройки цикла. -->
            <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                <Label Text="Настройки" Style="{StaticResource CardTitle}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="День зарплаты" VerticalOptions="Center"/>
                    <Picker Grid.Column="1" ItemsSource="{Binding PaydayDayOptions}" SelectedIndex="{Binding PaydayDayIndex}" WidthRequest="170"/>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                <Label Text="Цикл: якорная дата и длина (сменный график)" Style="{StaticResource MutedText}"/>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <DatePicker Date="{Binding CycleAnchorDate}" Format="d MMM yyyy"/>
                    <Entry Text="{Binding CycleDaysText}" Placeholder="30" WidthRequest="80" Keyboard="Numeric"/>
                    <Label Text="дн." VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </HorizontalStackLayout>
                <Button Text="Сохранить настройки" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
