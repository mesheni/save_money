<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             x:Class="SaveMoney.Views.PaydayPage"
             Title="До зарплаты"
             Appearing="OnAppearing">

    <ScrollView>
        <VerticalStackLayout Padding="14,6" Spacing="14">

            <Border Style="{StaticResource Card}" Padding="18,16">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding PaydayText}" Style="{StaticResource CardTitle}"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding BalanceText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    <Label Text="{Binding UpcomingText}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                    <Label Text="{Binding CanSpendText}" FontSize="30" FontAttributes="Bold"
                           Margin="0,8,0,0"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{Binding PerDayText}" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center"/>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="11,5"
                                BackgroundColor="{AppThemeBinding Light={StaticResource IncomeSoftLight}, Dark={StaticResource IncomeSoftDark}}" HorizontalOptions="Start">
                            <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource IncomeTextLight}, Dark={StaticResource IncomeTextDark}}"/>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="warn">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarnSoftLight}, Dark={StaticResource WarnSoftDark}}"/>
                                    <Setter Property="StrokeShape" Value="RoundRectangle 999"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="minus">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ExpenseSoftLight}, Dark={StaticResource ExpenseSoftDark}}"/>
                                    <Setter Property="StrokeShape" Value="RoundRectangle 999"/>
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding CycleText}" Style="{StaticResource MutedText}" Margin="4,0,0,0"/>

            <Label Text="Настройки" Style="{StaticResource CardTitle}" Margin="4,4,0,0"/>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="День зарплаты" VerticalOptions="Center"/>
                        <Picker Grid.Column="1" ItemsSource="{Binding PaydayDayOptions}" SelectedIndex="{Binding PaydayDayIndex}" WidthRequest="170"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>

                    <Label Text="Цикл: якорная дата и длина (сменный график)" Style="{StaticResource MutedText}"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <DatePicker Date="{Binding CycleAnchorDate}" Format="d MMM yyyy"/>
                        <Entry Text="{Binding CycleDaysText}" Placeholder="30" WidthRequest="80" Keyboard="Numeric"/>
                        <Label Text="дн." VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    </HorizontalStackLayout>

                    <Button Text="Сохранить настройки" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
