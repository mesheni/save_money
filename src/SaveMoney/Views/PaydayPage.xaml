<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:svc="clr-namespace:SaveMoney.Core.Services;assembly=SaveMoney.Core"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.PaydayPage"
             Title="До зарплаты"
             Shell.NavBarIsVisible="False">

    <!-- Экран по макету: прогноз «можно тратить», прогресс цикла, разбивка,
         предстоящие платежи, блок бюджетов, настройки внизу. -->
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout x:Name="RootStack" Padding="16,12,16,16" Spacing="16">

            <!-- Шапка: назад + заголовок. -->
            <Grid ColumnDefinitions="Auto,*" Margin="-8,0,0,0">
                <Button Grid.Column="0" Text="{x:Static ctl:Glyphs.ArrowBack}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="24"
                        WidthRequest="48" MinimumHeightRequest="48" Padding="0" BackgroundColor="Transparent" BorderWidth="0"
                        Clicked="OnBackClicked" SemanticProperties.Description="Назад"/>
                <Label Grid.Column="1" Text="До зарплаты" Style="{StaticResource PageTitle}" VerticalOptions="Center"/>
            </Grid>

            <!-- Прогноз. -->
            <Border Style="{StaticResource HeroCard}">
<VerticalStackLayout Spacing="2">
                <Label Text="{Binding PaydayEndText}" FontSize="14"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Label Text="{Binding CanSpendText}" FontSize="40" TextColor="{DynamicResource OnPrimaryContainer}" FontFamily="InterBold">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CanSpendNegative}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PerDayText}" FontSize="16" FontFamily="InterSemiBold"
                           TextColor="{DynamicResource Primary}"/>
                    <Label Text="{Binding DaysLeftText}" FontSize="16"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
</Border>

            <!-- Прогресс цикла. -->
            <VerticalStackLayout Spacing="6">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" HeightRequest="8" Padding="0"
                        BackgroundColor="{DynamicResource SurfaceContainer}">
                    <ctl:AnimatedProgressBar Progress="{Binding CycleProgress}" HeightRequest="8"
                                             ProgressColor="{DynamicResource OnSurface}"/>
                </Border>
                <Grid ColumnDefinitions="*,Auto,*">
                    <Label Grid.Column="0" Text="{Binding CycleStartText}" FontSize="14"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Label Grid.Column="1" Text="{Binding CycleProgressText}" FontSize="14"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Label Grid.Column="2" Text="{Binding CycleEndText}" FontSize="14" HorizontalOptions="End"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Разбивка: остаток и платежи до зарплаты. -->
            <VerticalStackLayout Spacing="0">
                <BoxView HeightRequest="1"
                         Color="{DynamicResource OutlineVariant}"/>
                <Grid MinimumHeightRequest="48" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Остаток на счетах" FontSize="16" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding BalanceText}" FontSize="16" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{DynamicResource OutlineVariant}"/>
                <Grid MinimumHeightRequest="48" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Платежи до зарплаты" FontSize="16" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding UpcomingTotalText}" FontSize="16" FontFamily="InterSemiBold" VerticalOptions="Center"
                           TextColor="{DynamicResource OnSurfaceVariant}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasUpcomingTotal}" Value="True">
                                <Setter Property="TextColor" Value="{DynamicResource Error}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{DynamicResource OutlineVariant}"/>
            </VerticalStackLayout>

            <!-- Предстоящие платежи. -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Предстоящие платежи" FontSize="14"
                       TextColor="{DynamicResource OnSurfaceVariant}"
                       Margin="0,0,0,2"/>
                <VerticalStackLayout IsVisible="{Binding HasUpcomingItems}" BindableLayout.ItemsSource="{Binding UpcomingItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpcomingPaymentRow">
                            <Grid MinimumHeightRequest="48" Padding="0,4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="16" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DateText}" FontSize="14" VerticalOptions="Center"
                                       TextColor="{DynamicResource OnSurfaceVariant}"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding AmountText}" FontSize="16" FontFamily="InterSemiBold" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Предстоящих платежей до зарплаты нет" FontSize="14"
                       IsVisible="{Binding HasNoUpcomingItems}"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
            </VerticalStackLayout>

            <!-- Бюджеты. -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding BudgetCycleText}" FontSize="14" VerticalOptions="Center"
                           TextColor="{DynamicResource OnSurfaceVariant}"/>
                    <Button Grid.Column="1" Text="Добавить" Style="{StaticResource GhostButton}" FontSize="14"
                            Command="{Binding AddBudgetCommand}"/>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding HasBudgets}" BindableLayout.ItemsSource="{Binding BudgetItems}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:BudgetStatusRow">
                            <VerticalStackLayout Padding="0,8,0,10" Spacing="7">
                                <BoxView HeightRequest="1" Margin="0,-8,0,0"
                                         Color="{DynamicResource OutlineVariant}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" VerticalOptions="Center"/>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding FactText}" FontSize="16" FontFamily="InterSemiBold"/>
                                        <Label Text="{Binding PlanText}" FontSize="16"
                                               TextColor="{DynamicResource OnSurfaceVariant}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 3" HeightRequest="6" Padding="0"
                                        BackgroundColor="{DynamicResource SurfaceContainer}">
                                    <ctl:AnimatedProgressBar Progress="{Binding Percent}" HeightRequest="6"
                                                             ProgressColor="{DynamicResource Income}">
                                        <ctl:AnimatedProgressBar.Triggers>
                                            <DataTrigger TargetType="ctl:AnimatedProgressBar" Binding="{Binding IsOver}" Value="True">
                                                <Setter Property="ProgressColor" Value="{DynamicResource Error}"/>
                                            </DataTrigger>
                                        </ctl:AnimatedProgressBar.Triggers>
                                    </ctl:AnimatedProgressBar>
                                </Border>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static ctl:Glyphs.Warning}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="14" VerticalOptions="Center"
                                           IsVisible="{Binding IsOver}"
                                           TextColor="{DynamicResource Error}"/>
                                    <Label Text="{Binding OverText}" FontSize="14" FontFamily="InterSemiBold" VerticalOptions="Center"
                                           IsVisible="{Binding IsOver}"
                                           TextColor="{DynamicResource Error}"/>
                                    <Label Text="{x:Static ctl:Glyphs.Check}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="14" VerticalOptions="Center"
                                           IsVisible="{Binding IsWithinLimit}"
                                           TextColor="{DynamicResource Income}"/>
                                    <Label Text="{Binding OkText}" FontSize="14" FontFamily="InterSemiBold" VerticalOptions="Center"
                                           IsVisible="{Binding IsWithinLimit}"
                                           TextColor="{DynamicResource Income}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Лимиты не заданы" FontSize="14" IsVisible="{Binding HasNoBudgets}"
                       TextColor="{DynamicResource OnSurfaceVariant}"/>
            </VerticalStackLayout>

            <!-- Настройки цикла. -->
            <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                <Label Text="Настройки" Style="{StaticResource CardTitle}"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="День зарплаты" VerticalOptions="Center"/>
                    <ctl:MonetPicker Grid.Column="1" ItemsSource="{Binding PaydayDayOptions}" SelectedIndex="{Binding PaydayDayIndex}" WidthRequest="170"/>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{DynamicResource OutlineVariant}"/>
                <Label Text="Цикл: якорная дата и длина (сменный график)" Style="{StaticResource MutedText}"/>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <DatePicker Date="{Binding CycleAnchorDate}" Format="d MMM yyyy"/>
                    <Entry Text="{Binding CycleDaysText}" Placeholder="30" WidthRequest="80" Keyboard="Numeric"/>
                    <Label Text="дн." VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}"/>
                </HorizontalStackLayout>
                <Button Text="Сохранить настройки" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
