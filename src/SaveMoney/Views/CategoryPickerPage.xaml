<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.CategoryPickerPage" Title="Выбор категории">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Закрыть" Clicked="OnCancelClicked"/>
    </ContentPage.ToolbarItems>
    <ScrollView>
    <VerticalStackLayout Padding="16,8,16,16" Spacing="8">
        <!-- Поиск первым: он сквозной, по всем категориям и подкатегориям. -->
        <Border Padding="12,0" MinimumHeightRequest="48" StrokeShape="RoundRectangle 12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{x:Static ctl:Glyphs.Search}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18"
                       VerticalOptions="Center" TextColor="{DynamicResource OnSurfaceVariant}"/>
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Поиск, в том числе подкатегорий" BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing" SemanticProperties.Description="Поиск категории"/>
            </Grid>
        </Border>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding HasParent}" MinimumHeightRequest="48">
            <Button Text="{x:Static ctl:Glyphs.ArrowBack}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="22"
                    WidthRequest="48" Padding="0" BackgroundColor="Transparent" BorderWidth="0"
                    Command="{Binding ShowRootsCommand}" SemanticProperties.Description="Все категории"/>
            <Label Grid.Column="1" Text="{Binding ParentName}" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" VerticalOptions="Center"/>
        </Grid>
        <Button Text="Без подкатегории" Command="{Binding UseParentCommand}" Style="{StaticResource GhostButton}"
                IsVisible="{Binding HasParent}"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                    <Border Style="{StaticResource Card}" Padding="12,2" Margin="0,0,0,6">
                        <Border.Triggers>
                            <!-- Выбранная (или корень выбранной подкатегории) подсвечена фоном:
                                 у корня с подкатегориями справа стрелка, а не галочка. -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryContainer}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="32,*,28" ColumnSpacing="12" MinimumHeightRequest="48">
                            <Label Text="{Binding Icon, Converter={StaticResource IconGlyph}}" FontFamily="MaterialSymbolsRounded"
                                   FontAutoScalingEnabled="False" FontSize="24" VerticalOptions="Center" TextColor="{DynamicResource Primary}"/>
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" LineBreakMode="WordWrap" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded"
                                   FontAutoScalingEnabled="False" FontSize="24" IsVisible="{Binding ShowChildrenArrow}" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{x:Static ctl:Glyphs.Check}" FontFamily="MaterialSymbolsRounded"
                                   FontAutoScalingEnabled="False" FontSize="24" IsVisible="{Binding ShowCheck}" VerticalOptions="Center"/>
                            <Button Grid.ColumnSpan="3" Text="" Padding="0" BackgroundColor="Transparent" BorderWidth="0"
                                    Command="{Binding PickCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryPickerViewModel}}}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibleName}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <Label Text="Категории не найдены. Измените поиск." IsVisible="{Binding HasNoItems}"
               VerticalOptions="Center" HorizontalTextAlignment="Center" TextColor="{DynamicResource OnSurfaceVariant}"/>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
