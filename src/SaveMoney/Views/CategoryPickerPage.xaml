<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.CategoryPickerPage"
             Title="Все категории">

    <Grid RowDefinitions="*" Padding="16,8,16,12">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Строка: отступ 20 у подкатегорий, иконка, имя. Тап — выбор. -->
                        <Grid Grid.Row="0" MinimumHeightRequest="52" Padding="10,4" ColumnSpacing="12"
                              ColumnDefinitions="Auto,24,*,Auto"
                              BackgroundColor="{DynamicResource SurfaceContainer}"
                              SemanticProperties.Description="{Binding AccessibleName}"
                              SemanticProperties.Hint="Выбрать категорию">
                            <BoxView Grid.Column="0" Color="Transparent" WidthRequest="0" HorizontalOptions="Start">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Depth}" Value="0">
                                        <Setter Property="WidthRequest" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Depth}" Value="1">
                                        <Setter Property="WidthRequest" Value="20"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Depth}" Value="2">
                                        <Setter Property="WidthRequest" Value="40"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Depth}" Value="3">
                                        <Setter Property="WidthRequest" Value="60"/>
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label Grid.Column="1" Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                   FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="20"
                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{Binding Name}" FontSize="16" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Depth}" Value="0">
                                        <Setter Property="FontFamily" Value="InterSemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Depth}" Value="1">
                                        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="3" Text="{x:Static ctl:Glyphs.ChevronRight}" FontFamily="MaterialSymbolsRounded" FontAutoScalingEnabled="False" FontSize="18" VerticalOptions="Center"
                                   TextColor="{DynamicResource OnSurfaceVariant}"/>
                            <Button Grid.ColumnSpan="4" Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                    Command="{Binding PickCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryPickerViewModel}}}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibleName}"
                                    SemanticProperties.Hint="Выбрать категорию"/>
                        </Grid>
                        <BoxView Grid.Row="1" HeightRequest="1"
                                 Color="{DynamicResource OutlineVariant}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
