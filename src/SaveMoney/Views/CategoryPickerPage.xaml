<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaveMoney.ViewModels"
             xmlns:ctl="clr-namespace:SaveMoney.Controls"
             x:Class="SaveMoney.Views.CategoryPickerPage"
             Title="Все категории">

    <Grid RowDefinitions="Auto,*" Padding="16,16,16,12">

        <Label Grid.Row="0" Text="Все категории" Style="{StaticResource ScreenTitle}" Margin="0,0,0,8"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Строка: отступ 20 у подкатегорий, иконка, имя. Тап — выбор. -->
                        <Grid Grid.Row="0" HeightRequest="52" ColumnSpacing="12"
                              ColumnDefinitions="20,24,*">
                            <BoxView Grid.Column="0" Color="Transparent" WidthRequest="20" HorizontalOptions="Start">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Depth}" Value="0">
                                        <Setter Property="WidthRequest" Value="0"/>
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label Grid.Column="1" Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                   FontFamily="MaterialSymbolsRounded" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{Binding Name}" FontSize="15" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Depth}" Value="0">
                                        <Setter Property="FontFamily" Value="InterSemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Depth}" Value="1">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickCommand, Source={RelativeSource AncestorType={x:Type vm:CategoryPickerViewModel}}}"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Grid.Row="1" HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
