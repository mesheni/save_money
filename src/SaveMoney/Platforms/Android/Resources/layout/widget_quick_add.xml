<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_btn_100"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:text="＋100"
        android:textColor="@color/monet_widget_on_container"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_btn_500"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:text="＋500"
        android:textColor="@color/monet_widget_on_container"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_btn_1000"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:text="＋1000"
        android:textColor="@color/monet_widget_on_container"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_btn_custom"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_btn_bg"
        android:src="@drawable/widget_ic_edit"
        android:scaleType="centerInside"
        android:contentDescription="Своя сумма" />

</LinearLayout>
